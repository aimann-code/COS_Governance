{
  "standard": "Naming Standard",
  "version": "0.2.0",
  "status": "frozen by user; not published",
  "decision_ref": "D67",
  "approval_evidence": "User: ok freeze name standard",
  "preserve": [
    "SYS_EMP_ID",
    "EMP_Reg"
  ],
  "rules": [
    {
      "ref": "NAM-FRZ-R01",
      "rule": "Use the frozen Code_Shortcode catalogue for code terms. Abbreviations are controlled; do not independently introduce alternatives.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R02",
      "rule": "Use COS where it identifies the framework/project or governed document and com.cos namespaces. Do not require COS on every internal class, method, file, DTO, route or database object. Shared names omit emp; domain-specific names include the applicable shortcode.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R03",
      "rule": "Classes and React component symbols use PascalCase; Java public-class filenames match exactly. Repository classes use the Repo suffix.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R04",
      "rule": "Custom Java/TypeScript methods use camelCase with clear action/object meaning; they no longer require COS_ACTION_OBJECT.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R05",
      "rule": "Use PascalCase purpose/direction plus DTO suffix for transport types; shared envelopes omit a domain token and domain payloads include one. Internal commands remain distinct from transport DTOs.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R06",
      "rule": "Use kebab-case role-based TypeScript utility filenames and kebab-case React component filenames without a mandatory cos- prefix.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R07",
      "rule": "Use lower_snake_case schema, table and column identifiers. Employee-domain schema is emp rather than people. Scope/ownership still determines whether a table belongs in that schema.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R08",
      "rule": "Use UPPER_SNAKE_CASE constants/controlled codes and full readable frontend/document labels. Keep architecture-level suffix words out of frontend navigation.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R09",
      "rule": "Within a namespace a shortcode has one meaning. reg means registration; use Register for a governed catalogue where needed. Do not use res for both response and resource.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R10",
      "rule": "Preserve established identifiers and tokens including SYS_EMP_ID and EMP_Reg. Master names have no RPT suffix. Do not silently rename external headers or values.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R11",
      "rule": "Use resource-oriented URLs and clear unique camelCase operation IDs without a mandatory COS prefix. Preserve required framework/tool/third-party names and explicitly map exceptions.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    },
    {
      "ref": "NAM-FRZ-R12",
      "rule": "Frozen naming changes require an explicit decision and impact mapping. Existing code, database columns, API properties/routes, encryption contexts and references are migrated only through reviewed compatibility handling; this freeze does not perform those changes.",
      "status": "Frozen by user; not published",
      "source_version": "0.2.0"
    }
  ],
